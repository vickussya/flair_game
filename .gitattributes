# Normalize everything to LF in the repository. Unity always writes LF,
# so forcing LF in the working tree too keeps core.autocrlf from producing
# whole-file diffs on scenes and prefabs.
* text=auto eol=lf

# Windows-only scripts genuinely need CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

### Unity YAML ###
# merge=unityyamlmerge routes conflicts through Unity's Smart Merge tool.
# Enable it once per machine (see repo notes) or these fall back to a plain
# text merge, which is what git would have done anyway.
*.unity          text eol=lf merge=unityyamlmerge diff
*.prefab         text eol=lf merge=unityyamlmerge diff
*.asset          text eol=lf merge=unityyamlmerge diff
*.meta           text eol=lf merge=unityyamlmerge diff
*.mat            text eol=lf merge=unityyamlmerge diff
